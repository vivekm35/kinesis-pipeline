# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

AWS_REGION=us-east-1

# Kinesis
KINESIS_STREAM_NAME=kinesis-pipeline-dev-events
KINESIS_SHARD_COUNT=10

# Firehose
FIREHOSE_DELIVERY_STREAM=kinesis-pipeline-dev-events-firehose

# S3
S3_BUCKET=kinesis-pipeline-dev-landing-<ACCOUNT_ID>

# Redshift
REDSHIFT_HOST=your-cluster.abc123.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=analytics
REDSHIFT_USER=pipeline_user
REDSHIFT_PASSWORD=changeme
REDSHIFT_IAM_ROLE=arn:aws:iam::<ACCOUNT_ID>:role/kinesis-pipeline-redshift-s3-role

# SQS DLQ
DLQ_URL=https://sqs.us-east-1.amazonaws.com/<ACCOUNT_ID>/kinesis-pipeline-dev-events-dlq

# DynamoDB idempotency table
IDEMPOTENCY_TABLE=kinesis-pipeline-dev-idempotency
